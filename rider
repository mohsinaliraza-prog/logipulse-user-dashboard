    function calculateFare() {
      const base = 150;
      const tierCost = appState.bookingDraft.tierCost;
      const pkgCost = appState.bookingDraft.packageCost;
      const trafficSurcharge = 50;
      const total = base + tierCost + pkgCost + trafficSurcharge;

      document.getElementById('fare-base').innerText = `Rs. ${base}`;
      document.getElementById('fare-tier').innerText = `Rs. ${tierCost}`;
      document.getElementById('fare-total').innerText = `Rs. ${total}`;
    }

    function loadTemplateBooking() {
      document.getElementById('booking-pickup-address').value = 'Office 402, Business Avenue, Main Shahrah-e-Faisal, Karachi';
      document.getElementById('booking-pickup-name').value = 'Zainab Fatima (LogiPulse Karachi HQ)';
      document.getElementById('booking-pickup-phone').value = '+92 300 8219430';
      document.getElementById('booking-dropoff-address').value = 'Plot 18-C, Bukhari Commercial, DHA Phase 6, Karachi';
      document.getElementById('booking-recipient-name').value = 'Dr. Asim Raza';
      document.getElementById('booking-recipient-phone').value = '+92 321 9876543';
      document.getElementById('booking-notes').value = 'Opposite Masjid-e-Saheem, dial #0912 or call on arrival.';
      showToast('⚡ Karachi sample delivery details loaded!');
      calculateFare();
    }

    function fillSavedAddress(type) {
      if (type === 'pickup') {
        document.getElementById('booking-pickup-address').value = 'Shahrah-e-Faisal Main Hub, PECHS Block 6, Karachi';
        document.getElementById('booking-pickup-name').value = 'Dispatch Officer Kamran';
        document.getElementById('booking-pickup-phone').value = '+92 301 2233445';
      } else {
        document.getElementById('booking-dropoff-address').value = 'Clifton Block 2, near Bilawal House, Karachi';
        document.getElementById('booking-recipient-name').value = 'Mrs. Ayesha Siddiqui';
        document.getElementById('booking-recipient-phone').value = '+92 333 4412098';
      }
      showToast(`Autofilled Karachi ${type} address`);
    }

    function submitCourierRequest() {
      const pickup = document.getElementById('booking-pickup-address').value.trim();
      const dropoff = document.getElementById('booking-dropoff-address').value.trim();
      const recipient = document.getElementById('booking-recipient-name').value.trim();

      if (!pickup || !dropoff || !recipient) {
        alert('Please provide Pickup Address, Dropoff Address, and Recipient Name.');
        return;
      }

      const newId = `LP-${Math.floor(1000 + Math.random() * 9000)}`;
      const newPin = `${Math.floor(1000 + Math.random() * 9000)}`;

      const assignedRider = {
        name: 'Tariq Mehmood',
        phone: '+92 (300) 492-8114',
        rating: 4.97,
        deliveries: 2411,
        vehicle: 'Road Prince EV Bike (KHI-8920)',
        avatar: 'TM',
        status: 'Dispatched to Pickup'
      };

      const newOrder = {
        id: newId,
        recipient: recipient,
        phone: document.getElementById('booking-recipient-phone').value || '+92 (300) 000-0000',
        pickup: pickup,
        destination: dropoff,
        pkgType: appState.bookingDraft.packageType.toUpperCase() + ' Parcel',
        weight: '1.5 kg',
        tier: 'LogiPulse Direct',
        status: 'in_transit',
        statusLabel: 'Rider Dispatched',
        eta: '22 mins',
        rider: assignedRider,
        cost: document.getElementById('fare-total').innerText,
        pin: newPin
      };

      appState.orders.unshift(newOrder);
      appState.chatLogs['Tariq Mehmood'].push({
        sender: 'rider',
        text: `Assalam-o-Alaikum! Mujhe aap ka new order ${newId} assign hua hai. Pickup ke liye nikal raha hoon.`,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      });

      showToast(`🎉 Order ${newId} confirmed! Assigned to Tariq Mehmood (EV Bike)`);
      selectActiveOrder(newId);
      switchView('tracking');
    }

    function regeneratePin() {
      const pin = `${Math.floor(1000 + Math.random() * 9000)}`;
      appState.activePin = pin;
      document.getElementById('pin-display').innerText = pin.split('').join(' ');
      showToast('Naya Handover PIN generate ho gaya hai');
    }

    function topUpWallet() {
      appState.walletBalance += 2000;
      showToast('+Rs. 2,000 topped up via JazzCash!');
    }

    function openRiderChat(riderName) {
      appState.currentChatRider = riderName;
      document.getElementById('chat-rider-name').innerText = riderName;
      document.getElementById('chat-modal').classList.remove('hidden');
      renderChatMessages();
    }

    function openRiderChatCurrent() {
      const order = appState.orders.find(o => o.id === appState.selectedOrderId);
      if (order) openRiderChat(order.rider.name);
    }

    function closeRiderChat() {
      document.getElementById('chat-modal').classList.add('hidden');
    }

    function renderChatMessages() {
      const container = document.getElementById('chat-messages-container');
      const messages = appState.chatLogs[appState.currentChatRider] || [];
      container.innerHTML = messages.map(m => {
        const isUser = m.sender === 'user';
        return `
          <div class="flex flex-col ${isUser ? 'items-end' : 'items-start'}">
            <div class="max-w-[80%] rounded-2xl p-3 ${isUser ? 'bg-emerald-500 text-slate-950 font-medium' : 'bg-slate-800 text-white'}">
              <p>${m.text}</p>
            </div>
            <span class="text-[10px] text-slate-500 mt-1 px-1">${m.time}</span>
          </div>
        `;
      }).join('');
      container.scrollTop = container.scrollHeight;
    }

    function sendChatMessage() {
      const input = document.getElementById('chat-input');
      const text = input.value.trim();
      if (!text) return;

      const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      appState.chatLogs[appState.currentChatRider].push({
        sender: 'user',
        text: text,
        time: now
      });
      input.value = '';
      renderChatMessages();

      setTimeout(() => {
        const replies = [
          "Jee theek hai, main pohonch kar gate pe call karta hoon.",
          "Samajh gaya Baji, raste mein thoda traffic hai FTC pe, 5 minute mein aa raha hoon.",
          "Ji bilkul, PIN code confirm kar ke handover kar doon ga."
        ];
        const randomReply = replies[Math.floor(Math.random() * replies.length)];
        appState.chatLogs[appState.currentChatRider].push({
          sender: 'rider',
          text: randomReply,
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
        });
        renderChatMessages();
      }, 1300);
    }

    function sendQuickChip(text) {
      document.getElementById('chat-input').value = text;
      sendChatMessage();
    }

    function callRider(riderName) {
      document.getElementById('call-rider-name').innerText = riderName;
      document.getElementById('call-modal').classList.remove('hidden');
    }

    function callRiderCurrent() {
      const order = appState.orders.find(o => o.id === appState.selectedOrderId);
      if (order) callRider(order.rider.name);
    }

    function closeCallModal() {
      document.getElementById('call-modal').classList.add('hidden');
      showToast('Call ended');
    }

    function recenterMap() {
      const rider = document.getElementById('animated-rider-marker');
      rider.classList.add('scale-125');
      setTimeout(() => rider.classList.remove('scale-125'), 500);
      showToast('📍 Radar camera locked onto Rider (Korangi Road leg)');
    }

    function handleGlobalSearch(term) {
      const q = term.toLowerCase().trim();
      if (!q) {
        renderOverviewTable();
        renderFullOrdersTable();
        return;
      }
      const matched = appState.orders.filter(o => 
        o.id.toLowerCase().includes(q) ||
        o.recipient.toLowerCase().includes(q) ||
        o.destination.toLowerCase().includes(q) ||
        o.rider.name.toLowerCase().includes(q)
      );
      if (appState.currentView === 'overview') {
        renderOverviewTable(matched);
      } else if (appState.currentView === 'orders') {
        renderFullOrdersTable(matched);
      }
    }

    function showToast(message) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto bg-slate-900 border border-emerald-500/40 text-white text-xs px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-2.5 transform transition-all translate-y-2 opacity-0';
      toast.innerHTML = `
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span class="font-medium">${message}</span>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 50);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function exportOrdersCSV() {
      const headers = ['Order_ID', 'Recipient', 'Pickup_Karachi', 'Destination_Karachi', 'Status', 'Rider', 'Cost_PKR'];
      const rows = appState.orders.map(o => [
        o.id,
        `"${o.recipient}"`,
        `"${o.pickup}"`,
        `"${o.destination}"`,
        o.status,
        `"${o.rider.name}"`,
        `"${o.cost}"`
      ]);
      const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `LogiPulse_Karachi_Shipments_${Date.now()}.csv`;
      a.click();
      showToast('Karachi shipments exported to CSV');
    }

    let angle = 0;
    setInterval(() => {
      const marker = document.getElementById('animated-rider-marker');
      if (marker && appState.currentView === 'tracking') {
        angle += 0.05;
        const xOffset = Math.sin(angle) * 8;
        const yOffset = Math.cos(angle) * 4;
        marker.setAttribute('transform', `translate(${500 + xOffset}, ${255 + yOffset})`);
      }
    }, 150);

    window.addEventListener('DOMContentLoaded', () => {
      renderOverviewTable();
      renderFullOrdersTable();
      renderRidersGrid();
      calculateFare();
    });
  </script>
</body>
</html>

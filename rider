<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LogiPulse Karachi - Courier & Last-Mile Delivery Platform</title>
  <!-- Tailwind CSS via official CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              900: '#064e3b',
            },
            pulse: {
              cyan: '#06b6d4',
              blue: '#3b82f6',
              indigo: '#6366f1',
              violet: '#8b5cf6',
            }
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(156, 163, 175, 0.4);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(156, 163, 175, 0.7);
    }
    .map-grid-pattern {
      background-size: 28px 28px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen antialiased flex flex-col selection:bg-emerald-500 selection:text-white">

  <!-- Top Toast Notification Container -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Main App Shell -->
  <div class="flex h-screen overflow-hidden">
    
    <!-- Sidebar Navigation -->
    <aside class="w-64 bg-slate-950/80 backdrop-blur-xl border-r border-slate-800/80 flex flex-col justify-between flex-shrink-0 z-20">
      <div>
        <!-- Brand Header -->
        <div class="h-18 px-6 flex items-center justify-between border-b border-slate-800/60 py-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 via-teal-400 to-cyan-500 flex items-center justify-center shadow-lg shadow-emerald-500/20 text-white font-extrabold text-xl tracking-tighter">
              <svg class="w-6 h-6 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="font-bold text-lg tracking-tight text-white">Logi<span class="text-emerald-400">Pulse</span></span>
                <span class="px-1.5 py-0.5 text-[9px] font-bold tracking-wider uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded">Karachi</span>
              </div>
              <p class="text-xs text-slate-400">Last-Mile Delivery OS</p>
            </div>
          </div>
        </div>

        <!-- Quick Action Button -->
        <div class="px-4 mt-5">
          <button onclick="switchView('book')" class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl font-semibold text-sm bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 shadow-lg shadow-emerald-500/25 transition-all transform active:scale-[0.98]">
            <svg class="w-4 h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Book Courier Rider</span>
          </button>
        </div>

        <!-- Navigation Links -->
        <nav class="px-3 mt-6 space-y-1">
          <button onclick="switchView('overview')" id="nav-overview" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span>Dashboard Overview</span>
          </button>

          <button onclick="switchView('tracking')" id="nav-tracking" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-300 hover:bg-slate-800/60 hover:text-white">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Live Karachi Radar</span>
            </div>
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
            </span>
          </button>

          <button onclick="switchView('riders')" id="nav-riders" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-300 hover:bg-slate-800/60 hover:text-white">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <span>Assigned Riders</span>
            </div>
            <span id="badge-riders-count" class="px-2 py-0.5 text-xs font-semibold bg-slate-800 text-slate-300 rounded-full border border-slate-700">3</span>
          </button>

          <button onclick="switchView('orders')" id="nav-orders" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-300 hover:bg-slate-800/60 hover:text-white">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              <span>My Shipments</span>
            </div>
            <span id="badge-active-orders" class="px-2 py-0.5 text-xs font-semibold bg-emerald-500/20 text-emerald-400 rounded-full border border-emerald-500/30">3 Active</span>
          </button>

          <button onclick="switchView('book')" id="nav-book" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-300 hover:bg-slate-800/60 hover:text-white">
            <svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <span>Request Delivery</span>
          </button>
        </nav>
      </div>

      <!-- User Profile & Karachi Wallet Footer -->
      <div class="p-4 border-t border-slate-800/80 bg-slate-950/40">
        <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3 mb-3">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span>LogiPulse Wallet (PKR)</span>
            <span class="text-emerald-400 font-semibold text-xs">EasyPaisa / JazzCash</span>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-lg font-bold text-white">Rs. 8,450</span>
            <button onclick="topUpWallet()" class="text-xs text-emerald-400 hover:text-emerald-300 font-medium underline underline-offset-2">+ Top Up</button>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="relative">
              <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center font-bold text-white ring-2 ring-emerald-500/40">
                ZF
              </div>
              <div class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 rounded-full ring-2 ring-slate-950"></div>
            </div>
            <div>
              <p class="text-sm font-semibold text-white">Zainab Fatima</p>
              <p class="text-xs text-slate-400">Karachi Enterprise</p>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-slate-900">
      
      <!-- Top Navigation & Live Ticker -->
      <header class="h-18 px-8 py-3.5 border-b border-slate-800 bg-slate-950/50 backdrop-blur-md flex items-center justify-between flex-shrink-0 z-10">
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-slate-800/80 border border-slate-700 text-xs">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-slate-300">Active Karachi Order: <strong class="text-white font-medium">#LP-9842</strong></span>
            <span class="text-slate-500">•</span>
            <span class="text-emerald-400 font-semibold" id="ticker-eta">En Route to DHA Phase 6 (~12 mins)</span>
            <button onclick="switchView('tracking'); selectActiveOrder('LP-9842')" class="text-xs text-cyan-400 hover:text-cyan-300 font-semibold underline underline-offset-2 ml-1">Live Map →</button>
          </div>

          <div class="hidden lg:flex items-center gap-2 text-xs text-slate-400">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>All 4 Karachi Hubs Active (Shahrah-e-Faisal, Clifton, Gulshan, Korangi)</span>
          </div>
        </div>

        <!-- Global Search -->
        <div class="flex items-center gap-3">
          <div class="relative">
            <input type="text" id="global-search" oninput="handleGlobalSearch(this.value)" placeholder="Search Karachi tracking ID, rider, area..." 
              class="w-72 bg-slate-900/90 border border-slate-700/80 rounded-xl px-3.5 py-2 pl-9 text-xs text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all">
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>

          <button onclick="switchView('book')" class="flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold px-3 py-2 rounded-xl transition-all shadow-md shadow-emerald-500/20">
            <span>+ Book Rider</span>
          </button>
        </div>
      </header>

      <!-- Scrollable Main Content -->
      <main class="flex-1 overflow-y-auto p-6 lg:p-8 space-y-8">

        <!-- ================= VIEW 1: DASHBOARD OVERVIEW ================= -->
        <section id="view-overview" class="view-panel space-y-8">
          
          <!-- Karachi Welcome Hero -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 p-6 lg:p-8 rounded-3xl border border-slate-800/80 shadow-2xl relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute right-40 -top-10 w-60 h-60 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold mb-3">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Karachi Last-Mile Fleet • Shahrah-e-Faisal Hub Online</span>
              </div>
              <h1 class="text-2xl lg:text-3xl font-extrabold text-white tracking-tight">Khushamdeed, Zainab 👋</h1>
              <p class="text-slate-400 text-sm mt-1 max-w-xl">You have <strong class="text-emerald-400 font-semibold">3 active shipments</strong> en route across Clifton, DHA Phase 6, and Gulshan-e-Iqbal with dedicated riders.</p>
            </div>

            <div class="flex items-center gap-3 relative z-10 flex-wrap">
              <button onclick="switchView('tracking')" class="px-5 py-3 rounded-2xl bg-slate-800/90 hover:bg-slate-700/90 text-white text-xs font-bold border border-slate-700/80 flex items-center gap-2.5 transition-all shadow-md">
                <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                </svg>
                <span>Live Karachi Radar</span>
              </button>

              <button onclick="switchView('book')" class="px-5 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 text-xs font-extrabold flex items-center gap-2 shadow-lg shadow-emerald-500/25 transition-all transform active:scale-95">
                <svg class="w-4 h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Request Instant Rider</span>
              </button>
            </div>
          </div>

          <!-- KPI Metric Cards (PKR & Local Delivery SLAs) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <!-- Active Deliveries -->
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
              <div class="flex items-center justify-between text-slate-400 mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider">Active In-Transit</span>
                <span class="p-2 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </span>
              </div>
              <div class="flex items-baseline justify-between">
                <span class="text-3xl font-extrabold text-white" id="stat-active-count">3</span>
                <span class="text-xs font-medium text-emerald-400 flex items-center gap-1">
                  2 en route
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-2">DHA dropoff in <strong class="text-slate-300">~12 mins</strong></p>
            </div>

            <!-- Assigned Riders -->
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
              <div class="flex items-center justify-between text-slate-400 mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider">Assigned Fleet</span>
                <span class="p-2 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                  </svg>
                </span>
              </div>
              <div class="flex items-baseline justify-between">
                <span class="text-3xl font-extrabold text-white">3 Riders</span>
                <span class="text-xs font-medium text-amber-400">★ 4.96 Avg Rating</span>
              </div>
              <p class="text-xs text-slate-500 mt-2">Tariq (EV Bike), Bilal (125), Hamza</p>
            </div>

            <!-- Average Speed in Karachi -->
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
              <div class="flex items-center justify-between text-slate-400 mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider">Avg Karachi Delivery</span>
                <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </span>
              </div>
              <div class="flex items-baseline justify-between">
                <span class="text-3xl font-extrabold text-white">28.4 min</span>
                <span class="text-xs font-medium text-emerald-400 flex items-center gap-1">
                  Traffic bypass active
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-2">Under 35 min SLA met</p>
            </div>

            <!-- Monthly Karachi Deliveries -->
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
              <div class="flex items-center justify-between text-slate-400 mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider">Delivered (Karachi)</span>
                <span class="p-2 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </span>
              </div>
              <div class="flex items-baseline justify-between">
                <span class="text-3xl font-extrabold text-white">184 Parcels</span>
                <span class="text-xs font-medium text-purple-400">100% Success</span>
              </div>
              <p class="text-xs text-slate-500 mt-2">All sectors verified with PIN</p>
            </div>
          </div>

          <!-- Active Order Spotlight: Shahrah-e-Faisal to DHA Phase 6 -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <div class="lg:col-span-2 bg-slate-950/80 border border-slate-800/80 rounded-3xl p-6 shadow-xl flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-4 border-b border-slate-800">
                  <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></div>
                    <div>
                      <h3 class="text-base font-bold text-white flex items-center gap-2">
                        <span>Karachi Priority Delivery:</span>
                        <span class="text-emerald-400 font-mono" id="spotlight-order-id">#LP-9842</span>
                      </h3>
                      <p class="text-xs text-slate-400">LogiPulse Direct • Medical & Electronics Box</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">Out for Delivery</span>
                    <button onclick="switchView('tracking')" class="px-3 py-1 text-xs font-semibold rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors">Expand Radar →</button>
                  </div>
                </div>

                <!-- Karachi Route Preview -->
                <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-5">
                  <div class="h-48 rounded-2xl bg-slate-900 border border-slate-800 relative overflow-hidden map-grid-pattern p-4 flex flex-col justify-between">
                    <div class="flex items-center justify-between text-[11px] text-slate-400 z-10">
                      <span class="bg-slate-950/80 px-2 py-0.5 rounded border border-slate-800">Shahrah-e-Faisal → DHA Phase 6</span>
                      <span class="bg-emerald-500/20 text-emerald-300 font-semibold px-2 py-0.5 rounded border border-emerald-500/30" id="spotlight-time">12 min left</span>
                    </div>

                    <!-- Vector Route: FTC to Korangi Road to DHA Phase 6 -->
                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                      <svg class="w-full h-full p-4" viewBox="0 0 300 150">
                        <path d="M 30,120 Q 110,30 190,80 T 270,30" fill="none" stroke="#1e293b" stroke-width="6" stroke-linecap="round"/>
                        <path d="M 30,120 Q 110,30 190,80" fill="none" stroke="#10b981" stroke-width="4" stroke-dasharray="4 4" stroke-linecap="round"/>
                        
                        <circle cx="30" cy="120" r="7" fill="#059669"/>
                        <text x="30" y="140" fill="#94a3b8" font-size="9" text-anchor="middle" font-weight="bold">FTC Hub</text>

                        <!-- Moving Rider Pin -->
                        <g transform="translate(190, 80)">
                          <circle r="12" fill="#06b6d4" opacity="0.3" class="animate-ping"/>
                          <circle r="8" fill="#06b6d4" stroke="#ffffff" stroke-width="2"/>
                        </g>

                        <circle cx="270" cy="30" r="7" fill="#6366f1"/>
                        <text x="270" y="20" fill="#94a3b8" font-size="9" text-anchor="middle" font-weight="bold">DHA Phase 6</text>
                      </svg>
                    </div>

                    <div class="z-10 flex items-center justify-between text-xs bg-slate-950/90 backdrop-blur border border-slate-800/80 px-3 py-2 rounded-xl">
                      <div class="flex items-center gap-2">
                        <span class="text-slate-400">Current Speed:</span>
                        <span class="text-white font-mono font-bold">42 km/h</span>
